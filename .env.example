# URL backend-сервера. Используется для:
#  - проксирования /api в dev-сервере Vite (vite.config.ts)
#  - построения абсолютных URL изображений (src/services/api/api.ts -> buildImageUrl)
VITE_BACKEND_URL=https://digital-memory.ru/api

# Номер счётчика Яндекс Метрики (Метрика -> Настройки -> Номер счётчика).
# Если пуст — счётчик не подключается (локальная разработка и стенды не шумят в статистике).
VITE_METRIKA_ID=

# Тестовый админ для e2e (login -> GET /api/card/get/{id}). Впиши реальные значения в .env
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=changeme
